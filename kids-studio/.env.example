# Copy to .env and fill in real values. Safe to commit — no secrets here.

# --- Generation pipeline ---
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
FAL_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Optional overrides (sane defaults baked into main.py)
# OPENAI_TEXT_MODEL=gpt-5-mini
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Public URL this service is reachable at (used in generated video/image
# URLs). Defaults to localhost; set once deployed.
PUBLIC_BASE_URL=http://127.0.0.1:8002

# --- Publishing: Cloudinary (public-URL intermediary for TikTok/IG/FB) ---
# Use a dedicated free-tier account for kids-studio, not the main app's.
KIDS_CLOUDINARY_CLOUD_NAME=
KIDS_CLOUDINARY_API_KEY=
KIDS_CLOUDINARY_API_SECRET=

# --- Publishing: TikTok Content Posting API v2 ---
# Dedicated kids TikTok account + developer app with Content Posting API access.
KIDS_TIKTOK_ACCESS_TOKEN=
KIDS_TIKTOK_REFRESH_TOKEN=
KIDS_TIKTOK_CLIENT_KEY=
KIDS_TIKTOK_CLIENT_SECRET=

# --- Publishing: Instagram (API with Instagram Login) ---
# Dedicated kids Instagram Business/Creator account.
KIDS_INSTAGRAM_ACCESS_TOKEN=
KIDS_INSTAGRAM_ACCOUNT_ID=

# --- Publishing: Facebook Page Reels ---
# Dedicated kids Facebook Page.
KIDS_FACEBOOK_PAGE_ACCESS_TOKEN=
KIDS_FACEBOOK_PAGE_ID=

# --- Publishing: daily post caps per platform (default 2 each) ---
KIDS_MAX_YOUTUBE_POSTS_PER_DAY=2
KIDS_MAX_TIKTOK_POSTS_PER_DAY=2
KIDS_MAX_INSTAGRAM_POSTS_PER_DAY=2
KIDS_MAX_FACEBOOK_POSTS_PER_DAY=2

# --- Publishing: YouTube (file-based, not env vars) ---
# kids_client_secret.json — OAuth Desktop-app client from Google Cloud Console.
# kids_token.json — generated automatically on first interactive consent run.
# Both live in this directory and are gitignored; see README.md for setup.
