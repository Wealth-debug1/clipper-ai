kids-studio/client_secret*.json
kids-studio/token*.json
kids-studio/kids_client_secret*.json
kids-studio/kids_token*.json

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ────────────────────────────────────────────────────────
venv/
venv_new/
.venv/
backend/venv/
backend/venv_new/
backend/.venv/

